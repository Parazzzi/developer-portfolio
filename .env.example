# Telegram notifications about site visits and CV downloads (app/api/track/route.ts).
# 1. Create a bot with @BotFather and copy its token.
# 2. Send any message to the bot, then open https://api.telegram.org/bot<TOKEN>/getUpdates
#    and copy "chat":{"id": ...} from the response.
# 3. Add both variables in Vercel → Project → Settings → Environment Variables (Production) and redeploy.
#    For local testing put them in .env.local. Without them the messages are only logged to the server console.
#
# Share the site as https://<your-site>/?ref=company-name to see who opened it.
# Open https://<your-site>/?notrack once in your own browsers to stop notifying yourself (?notrack=0 to undo).
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
